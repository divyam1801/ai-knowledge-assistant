DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_assistant
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
UPLOAD_DIR=./data/uploads
DEBUG=false

# --- LLM Provider ---
# Default provider for both embedding and chat
LLM_PROVIDER=gemini

# Optional: use different providers for embedding vs chat
# EMBED_PROVIDER=gemini
# CHAT_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=your-api-key-here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash

# --- LLM Gateway (optional proxy) ---
# GATEWAY_BASE_URL=https://your-gateway.example.com
# GATEWAY_API_KEY=your-gateway-key
